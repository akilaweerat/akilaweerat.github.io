modules = ["web", "nodejs-20"]
run = "index.html"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "python -m http.server 5000"]

[workflows]
runButton = "Serve HTML"

[[workflows.workflow]]
name = "Serve HTML"
author = 43035504
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m http.server 5000"
